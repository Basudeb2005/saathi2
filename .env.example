# ---- LiveKit -----------------------------------------------------------
# Self-hosted (free) or LiveKit Cloud. The room is where the agent, the
# person at home, and any caller all meet.
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SAATHI_ROOM_NAME=saathi-home

# Outbound trunk terminating at your own SIP server, where family members'
# Linphone apps are registered. Calls over this cost nothing per minute.
LIVEKIT_SIP_TRUNK_ID=

# Outbound trunk to a telephony provider, for contacts who only have a
# phone number. Bills per minute — leave blank if you don't need it.
LIVEKIT_PSTN_TRUNK_ID=

# ---- Models (all cloud; a local LLM on a Pi is 5-8s per turn) ----------
# This one key is enough to start — OpenAI covers LLM, STT and TTS.
OPENAI_API_KEY=

# Swap a piece out only when it bothers you: deepgram is faster at STT,
# elevenlabs is better at multilingual TTS.
# STT_PROVIDER=openai        # openai | deepgram
# TTS_PROVIDER=openai        # openai | elevenlabs
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# LLM_MODEL=gpt-4.1          # gpt-4o if your account hasn't got 4.1
# LLM_TEMPERATURE=0.7        # lower = same answer every time, which people hear
# DEEPGRAM_STT_MODEL=nova-3
# ELEVENLABS_VOICE_ID=

# How it sounds. coral is warm and low; sage is calmer; ballad gentler;
# onyx low and male; shimmer bright (and the reason it sounded like an
# announcement). The instructions line only works on gpt-4o-mini-tts,
# and it is the biggest single lever on not sounding like a machine.
# OPENAI_TTS_VOICE=coral
# TTS_SPEED=0.95             # below ~0.9 it stops sounding careful and starts sounding slurred
# OPENAI_TTS_INSTRUCTIONS=Speak like a warm, unhurried friend in the same room...

# ---- Mopidy ------------------------------------------------------------
# Runs on this same Pi and owns the speaker.
# MOPIDY_RPC_URL=http://localhost:6680/mopidy/rpc
# MUSIC_NORMAL_VOLUME=70
# MUSIC_DUCK_VOLUME=20

# ---- Radio Browser (free, no account, no key) --------------------------
# RADIO_BROWSER_URL=https://de1.api.radio-browser.info
# RADIO_BROWSER_UA=saathi/2.0

# ---- Wake word (on-device, nothing to train) ---------------------------
# openwakeword: pretrained, no account, no key, fully offline. Default.
# porcupine:    lets you generate a real "Hey Saathi" in seconds, but
#               needs a free key from console.picovoice.ai.
# WAKE_ENGINE=openwakeword

# Pretrained names: alexa, hey_mycroft, hey_jarvis, hey_rhasspy
# OWW_WORDS=hey_jarvis
# OWW_THRESHOLD=0.5

# WAKE_REFRACTORY_S=2.0
# ALSA capture device, e.g. plughw:3,0 — worth pinning on a Pi.
# WAKE_CAPTURE_DEVICE=

# --- only for WAKE_ENGINE=porcupine ---
# PORCUPINE_ACCESS_KEY=
# Custom phrase you generated, e.g. wake_models/hey_saathi.ppn
# PORCUPINE_KEYWORD_PATHS=
# Built-ins needing no file: jarvis, computer, bumblebee, grasshopper...
# PORCUPINE_KEYWORDS=jarvis
# PORCUPINE_SENSITIVITY=0.5

# ---- Languages ---------------------------------------------------------
# Name them. An unconstrained model given a noisy far-field signal does
# not return nothing — it invents a language, and you get Russian back.
# en=English hi=Hindi zh=Chinese ta=Tamil ms=Malay bn=Bengali
# AGENT_LANGUAGES=en,hi
# Several languages needs Deepgram: OpenAI has no code-switching mode.
# STT_PROVIDER=deepgram

# ---- Memory ------------------------------------------------------------
# What it remembers between conversations. Off by default.
# MEMORY_BACKEND=supermemory
# SUPERMEMORY_API_KEY=sm_...
# MEMORY_CONTAINER_TAG=saathi-home
# MEMORY_RECALL_LIMIT=6

# ---- Conversation ------------------------------------------------------
# wake_word | voice | button | space | always
#
# space is push-to-talk from the terminal you started it in: hold the
# spacebar to talk, let go to stop. Works over ssh, needs no hardware,
# and is the quickest way to feel what the wearable will feel like.
# WAKE_MODE=wake_word
# PTT_RELEASE_S=1.0          # must be wider than your key-repeat delay (~0.5s on macOS)
# PTT_STYLE=hold             # toggle if your key repeat is switched off
# Mute the mic while it speaks. Without echo cancellation an open mic
# hears the speaker and the agent answers itself.
# HALF_DUPLEX=true

# A USB keyboard plugged into the Pi is a push-to-talk button: evdev
# reports key-down and key-up exactly, needs no terminal, and works under
# systemd at boot with no monitor attached.
# WAKE_MODE=button
# BUTTON_PUSH_TO_TALK=true
# BUTTON_KEYS=KEY_SPACE      # with a real keyboard, name the key — the default is "any"
# BUTTON_HANGOVER_S=0.35     # mic stays open this long after release, so the last word survives

# ---- Headless console --------------------------------------------------
# Answers over Bluetooth with no network at all, and over HTTP once there
# is one. Runs as root and is gated on a generated token:
#   sudo cat /etc/saathi/console-token
# CONSOLE_HTTP_PORT=8765
# CONSOLE_SHELL=true         # false to drop the `sh` command
# CONSOLE_BT_CHANNEL=1

# When it can't reach a network it knows, it becomes one after 90s so a
# phone can still get in. CHANGE THE PASSWORD — this one is public.
# HOTSPOT_SSID=Saathi-Setup
# HOTSPOT_PASSWORD=saathi123
# HOTSPOT_AFTER_S=90
# HOTSPOT_RETRY_AFTER_S=600

# LOG_LEVEL=INFO
