# ---- LiveKit -----------------------------------------------------------
# Self-hosted (free) or LiveKit Cloud. The room is where the agent, the
# person at home, and any caller all meet.
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SAATHI_ROOM_NAME=saathi-home

# Outbound trunk terminating at your own SIP server, where family members'
# Linphone apps are registered. Calls over this cost nothing per minute.
LIVEKIT_SIP_TRUNK_ID=

# Outbound trunk to a telephony provider, for contacts who only have a
# phone number. Bills per minute — leave blank if you don't need it.
LIVEKIT_PSTN_TRUNK_ID=

# ---- Models (all cloud; a local LLM on a Pi is 5-8s per turn) ----------
# This one key is enough to start — OpenAI covers LLM, STT and TTS.
OPENAI_API_KEY=

# Swap a piece out only when it bothers you: deepgram is faster at STT,
# elevenlabs is better at multilingual TTS.
# STT_PROVIDER=openai        # openai | deepgram
# TTS_PROVIDER=openai        # openai | elevenlabs
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# LLM_MODEL=gpt-4o-mini
# OPENAI_TTS_VOICE=shimmer
# DEEPGRAM_STT_MODEL=nova-3
# ELEVENLABS_VOICE_ID=

# ---- Mopidy ------------------------------------------------------------
# Runs on this same Pi and owns the speaker.
# MOPIDY_RPC_URL=http://localhost:6680/mopidy/rpc
# MUSIC_NORMAL_VOLUME=70
# MUSIC_DUCK_VOLUME=20

# ---- Radio Browser (free, no account, no key) --------------------------
# RADIO_BROWSER_URL=https://de1.api.radio-browser.info
# RADIO_BROWSER_UA=saathi/2.0

# ---- Wake word (on-device, nothing to train) ---------------------------
# openwakeword: pretrained, no account, no key, fully offline. Default.
# porcupine:    lets you generate a real "Hey Saathi" in seconds, but
#               needs a free key from console.picovoice.ai.
# WAKE_ENGINE=openwakeword

# Pretrained names: alexa, hey_mycroft, hey_jarvis, hey_rhasspy
# OWW_WORDS=hey_jarvis
# OWW_THRESHOLD=0.5

# WAKE_REFRACTORY_S=2.0
# ALSA capture device, e.g. plughw:3,0 — worth pinning on a Pi.
# WAKE_CAPTURE_DEVICE=

# --- only for WAKE_ENGINE=porcupine ---
# PORCUPINE_ACCESS_KEY=
# Custom phrase you generated, e.g. wake_models/hey_saathi.ppn
# PORCUPINE_KEYWORD_PATHS=
# Built-ins needing no file: jarvis, computer, bumblebee, grasshopper...
# PORCUPINE_KEYWORDS=jarvis
# PORCUPINE_SENSITIVITY=0.5

# LOG_LEVEL=INFO
